# =========================================
# mPlugins Discord Bot - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env real.
# =========================================

# Ambiente de execucao: development ou production.
# Usado pelo ecosystem.config.js (PM2) e pelos scripts de deploy.
NODE_ENV=production

# ---- Discord ----
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Discord ID do dono do bot. Tem acesso total a todos os comandos
# administrativos em qualquer servidor, mesmo sem nenhum cargo configurado.
# Isso evita que um servidor fique sem ninguem capaz de configurar o bot
# caso o cargo de Bot Manager seja apagado por engano.
OWNER_ID=

# ---- Banco de dados ----
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mplugins
DB_USER=
DB_PASSWORD=

# ---- Painel (reservado para proxima etapa) ----
PANEL_HOST=127.0.0.1
PANEL_PORT=3000

PANEL_USERNAME=
PANEL_PASSWORD=

# ---- Webhook (reservado para proxima etapa) ----
WEBHOOK_SECRET=

# ---- Painel de tickets (todas opcionais, tem default se nao preencher) ----
TICKET_PANEL_TITULO=
TICKET_PANEL_HORARIO=
TICKET_PANEL_TEMPO_RESPOSTA=
TICKET_PANEL_BANNER_URL=
TICKET_PANEL_RODAPE=
TICKET_PANEL_COR=
